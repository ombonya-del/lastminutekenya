# LastMinuteKenya — client env (Vite exposes only VITE_* to the browser).
# Only the public anon key ever ships to the client. The service-role key and
# any channel secrets (SMS/WhatsApp/email) live ONLY in Supabase Edge Function
# env via `supabase secrets set ...` — never here, never in the bundle.

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Turnstile site key for public write forms (SOS / assessment requests).
VITE_TURNSTILE_SITE_KEY=
